<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Symfony Entwickler & Freelancer mit 20 Jahren Erfahrung | Achim Krämer{% endblock %}</title>
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('brand/favicon-main-32.png') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('brand/favicon-main-192.png') }}">
        <link rel="icon" type="image/png" sizes="512x512" href="{{ asset('brand/favicon-main-512.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('brand/favicon-main-192.png') }}">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">
        <meta name="theme-color" content="#f7f4ee">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="{% block robots %}follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large{% endblock %}">
        <meta name="description" content="{% block description %}Symfony Freelancer gesucht? Ich unterstütze ihr Projekt und bringe über 20 Jahre PHP-Erfahrung mit ein.{% endblock %}">
        <link rel="canonical" href="{{ app.request.uri }}">
        {% set base_route = app.request.attributes.get('_route')|default('')|split('.')|first %}
        {% if base_route starts with 'app_' %}
            <link rel="alternate" hreflang="de" href="{{ absolute_url(path(base_route ~ '.de')) }}">
            <link rel="alternate" hreflang="en" href="{{ absolute_url(path(base_route ~ '.en')) }}">
            <link rel="alternate" hreflang="x-default" href="{{ absolute_url(path(base_route ~ '.de')) }}">
        {% endif %}

        <!-- GEO Geographic Metadata (Local SEO) -->
        <meta name="geo.region" content="DE-NW">
        <meta name="geo.placename" content="Ibbenbüren">
        <meta name="geo.position" content="52.277416;7.716688">
        <meta name="ICBM" content="52.277416, 7.716688">

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('description') }}{% endblock %}">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta property="og:site_name" content="Achim Krämer | Symfony Freelancer">
        <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_US' : 'de_DE' }}">
        <meta property="og:image" content="{{ absolute_url(asset('build/images/DSC4074.jpeg')) }}">

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('description') }}">
        <meta name="twitter:image" content="{{ absolute_url(asset('build/images/DSC4074.jpeg')) }}">

        <!-- Structured Data (JSON-LD Schema) -->
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "name": "Achim Krämer",
          "image": "{{ absolute_url(asset('build/images/DSC4074.jpeg')) }}",
          "logo": "{{ absolute_url(asset('brand/favicon-main-512.png')) }}",
          "@id": "{{ absolute_url(path('app_home')) }}",
          "url": "{{ absolute_url(path('app_home')) }}",
          "telephone": "+49 1756 821391",
          "priceRange": "€€",
          "email": "kontakt@achim-kraemer.com",
          "description": "{{ 'app.home.description'|trans|e('js') }}",
          "areaServed": [
            {"@type": "City", "name": "Ibbenbüren"},
            {"@type": "City", "name": "Osnabrück"},
            {"@type": "AdministrativeArea", "name": "Münsterland"},
            {"@type": "Country", "name": "Deutschland"}
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "{{ 'app.nav.web'|trans|e('js') }}",
            "itemListElement": [
              {%- for o in [
                  {n: 1, price: 690, unit: null, min: true},
                  {n: 2, price: 15, unit: 'MON', min: false},
                  {n: 3, price: 49, unit: null, min: false},
                  {n: 4, price: 120, unit: null, min: false},
                  {n: 5, price: 0, unit: null, min: false},
                  {n: 6, price: 75, unit: 'HUR', min: false},
              ] %}
              {
                "@type": "Offer",
                "itemOffered": {"@type": "Service", "name": "{{ ('app.web.p' ~ o.n ~ '_title')|trans|e('js') }}", "description": "{{ ('app.web.p' ~ o.n ~ '_text')|trans|e('js') }}"},
                "priceSpecification": {
                  "@type": "{{ o.unit ? 'UnitPriceSpecification' : 'PriceSpecification' }}",
                  {% if o.min %}"minPrice": {{ o.price }},{% else %}"price": {{ o.price }},{% endif %}
                  "priceCurrency": "EUR",
                  {% if o.unit %}"unitCode": "{{ o.unit }}",{% endif %}
                  "valueAddedTaxIncluded": false
                }
              }{{ loop.last ? '' : ',' }}
              {%- endfor %}
            ]
          },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Böckemeyerskamp 20",
            "addressLocality": "Ibbenbüren",
            "postalCode": "49479",
            "addressCountry": "DE"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 52.277416,
            "longitude": 7.716688
          },
          "sameAs": [
            "https://www.linkedin.com/in/achim-kr%C3%A4mer-a72994213/",
            "https://github.com/achim-kraemer-com",
            "https://www.xing.com/profile/Achim_Kraemer5",
            "https://www.malt.com/profile/achimkramer",
            "https://www.freelancermap.de/profil/php-symfony-entwickler-279630",
            "https://www.gulp.de/gulp2/g/experten/selbststaendige/profile/6af0642e1789a70479fc20fe"
          ],
          "knowsAbout": ["Symfony", "PHP", "Web Development", "Webdesign", "SEO", "Webhosting", "E-Mail", "API development", "Docker", "AI Integration", "Agentic AI"],
          "founder": {"@id": "{{ absolute_url(path('app_home')) }}#person"}
        }
        </script>
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "@id": "{{ absolute_url(path('app_home')) }}#person",
          "name": "Achim Krämer",
          "url": "{{ absolute_url(path('app_home')) }}",
          "image": "{{ absolute_url(asset('build/images/DSC4074.jpeg')) }}",
          "jobTitle": "Symfony Freelancer & PHP Webentwickler",
          "worksFor": {"@id": "{{ absolute_url(path('app_home')) }}"},
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ibbenbüren",
            "postalCode": "49479",
            "addressCountry": "DE"
          },
          "sameAs": [
            "https://www.linkedin.com/in/achim-kr%C3%A4mer-a72994213/",
            "https://github.com/achim-kraemer-com",
            "https://www.xing.com/profile/Achim_Kraemer5",
            "https://www.malt.com/profile/achimkramer",
            "https://www.freelancermap.de/profil/php-symfony-entwickler-279630",
            "https://www.gulp.de/gulp2/g/experten/selbststaendige/profile/6af0642e1789a70479fc20fe"
          ],
          "knowsAbout": ["Symfony", "PHP", "Web Development", "API development", "Docker", "Database design", "AI Integration", "Agentic AI"]
        }
        </script>

        {% block structured_data %}{% endblock %}

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
