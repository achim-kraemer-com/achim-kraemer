{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block description %}{{ description }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('home') }}
{% endblock %}

{% block structured_data %}
    {% set faq_entities = [] %}
    {% for n in 1..10 %}
        {% set faq_entities = faq_entities|merge([{
            '@type': 'Question',
            'name': ('app.faq.q' ~ n)|trans,
            'acceptedAnswer': {'@type': 'Answer', 'text': ('app.faq.a' ~ n)|trans},
        }]) %}
    {% endfor %}
    <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq_entities}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
    <!-- Structured Data: Referenzprojekt Mirwena (Freelance-Entwicklung durch Achim Krämer) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Mirwena",
      "url": "https://mirwena.de",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Web",
      "inLanguage": "de",
      "description": "{{ 'app.references.mirwena_schema_description'|trans|escape('js') }}",
      "creator": {
        "@type": "ProfessionalService",
        "@id": "{{ absolute_url(path('app_home')) }}",
        "name": "Achim Krämer",
        "url": "{{ absolute_url(path('app_home')) }}"
      },
      "audience": {
        "@type": "BusinessAudience",
        "name": "Physiotherapie-, Osteopathie- und Ergotherapie-Praxen"
      }
    }
    </script>
{% endblock %}

{% block body %}
    {% include '_scroll_navigation.html.twig' with {'links': 'direct'} %}

    {# Profil-Links am rechten Rand, nur auf breiten Bildschirmen; mobil stehen sie im Footer #}
    <aside class="side-social" aria-label="Profile">
        {{ include('_social_links.html.twig', {link_class: 'side-social__link', icon_class: 'w-5 h-5'}) }}
    </aside>

    <main>
        {# ---------- Einstieg ---------- #}
        <section class="hero">
            <div class="wrap hero__grid">
                <div class="hero__text">
                    <h1 class="hero__kicker">{{ 'app.hero.kicker'|trans }}</h1>
                    <p class="hero__title">{{ 'app.hero.title'|trans }}</p>
                    <p class="hero__lead">{{ 'app.hero.text'|trans }}</p>
                    <div class="hero__actions">
                        <a href="#contact" class="btn btn-ink">{{ 'app.hero.cta'|trans }}</a>
                        <a href="tel:+491756821391" class="hero__call">
                            <span>{{ 'app.hero.call'|trans }}</span>
                            <strong>01756&nbsp;821391</strong>
                        </a>
                    </div>
                </div>
                <figure class="hero__photo">
                    <img src="{{ asset('build/images/achim-kraemer-portrait-640.jpeg') }}"
                         srcset="{{ asset('build/images/achim-kraemer-portrait-640.jpeg') }} 640w, {{ asset('build/images/achim-kraemer-portrait.jpeg') }} 900w"
                         sizes="(min-width: 900px) 416px, 216px"
                         alt="{{ 'app.hero.photo_alt'|trans }}" width="640" height="640" fetchpriority="high">
                    <figcaption>
                        <span>{{ 'app.me.fact1'|trans }}</span>
                        <span>{{ 'app.me.fact2'|trans }}</span>
                    </figcaption>
                </figure>
            </div>
        </section>

        {# ---------- Die zwei Bereiche ---------- #}
        <section class="areas" aria-labelledby="areas-title">
            <div class="wrap">
                <h2 id="areas-title" class="areas__title">{{ 'app.areas.title'|trans }}</h2>
                <div class="areas__grid">
                    {% for key, area in {
                        'dev': {anchor: '#entwicklung', num: '1'},
                        'web': {anchor: '#websites', num: '2'},
                    } %}
                        <article class="area area--{{ key }}">
                            <p class="area__for"><span class="area__num">{{ area.num }}</span>{{ ('app.areas.' ~ key ~ '_for')|trans }}</p>
                            <h3 class="area__title"><a href="{{ area.anchor }}">{{ ('app.areas.' ~ key ~ '_title')|trans }}</a></h3>
                            <p class="area__text">{{ ('app.areas.' ~ key ~ '_text')|trans }}</p>
                            <ul class="area__list">
                                {% for item in ('app.areas.' ~ key ~ '_items')|trans|split('|') %}
                                    <li>{{ item }}</li>
                                {% endfor %}
                            </ul>
                            <div class="area__foot">
                                <a href="{{ area.anchor }}" class="btn btn-{{ key }}">{{ ('app.areas.' ~ key ~ '_link')|trans }}</a>
                                {% if key == 'web' %}<span class="area__price">{{ 'app.areas.web_price'|trans }}</span>{% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ---------- Bereich 1: Individualentwicklung ---------- #}
        <span id="services" class="anchor-alias" aria-hidden="true"></span>
        <section id="entwicklung" class="section section--dev">
            <div class="wrap">
                <header class="section__head reveal">
                    <p class="kicker kicker--dev">{{ 'app.dev.kicker'|trans }}</p>
                    <h2 class="section__title">{{ 'app.dev.title'|trans }}</h2>
                    <p class="section__lead">{{ 'app.dev.lead'|trans }}</p>
                </header>

                <div class="offer-grid">
                    {% set dev_links = {
                        1: [['app_service_symfony', 'app.dev.more']],
                        2: [['app_service_symfony', 'app.dev.more']],
                        3: [['app_service_api', 'app.dev.more']],
                        4: [['app_service_ai', 'app.dev.more']],
                        5: [['app_service_upgrade', 'app.dev.upgrade'], ['app_service_maintenance', 'app.dev.maintenance']],
                        6: [],
                    } %}
                    {% for n, links in dev_links %}
                        <div class="offer">
                            <h3 class="offer__title">{{ ('app.dev.i' ~ n ~ '_title')|trans }}</h3>
                            <p class="offer__text">{{ ('app.dev.i' ~ n ~ '_text')|trans }}</p>
                            {% if links %}
                                <p class="offer__links">
                                    {% for l in links %}<a href="{{ path(l[0]) }}" class="arrow-link">{{ l[1]|trans }}</a>{% endfor %}
                                </p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                <div class="section__aside">
                    <div>
                        <p class="aside__label">{{ 'app.dev.tools_label'|trans }}</p>
                        <p class="aside__text">PHP 8 · Symfony 2–8 · Doctrine · MySQL / MariaDB · PostgreSQL · REST · GraphQL · Docker · CI/CD · OpenAI API</p>
                    </div>
                    <div>
                        <p class="aside__label">{{ 'app.dev.read_label'|trans }}</p>
                        <p class="aside__links">
                            <a href="{{ path('app_guide_agency') }}" class="arrow-link">{{ 'app.services.link_agency'|trans }}</a>
                            <a href="{{ path('app_region_muensterland') }}" class="arrow-link">{{ 'app.services.link_region'|trans }}</a>
                        </p>
                    </div>
                </div>

                <p class="section__cta"><a href="#contact" class="btn btn-dev">{{ 'app.dev.cta'|trans }}</a></p>
            </div>
        </section>

        {# ---------- Referenzen ---------- #}
        <section id="references" class="section section--refs">
            <div class="wrap">
                <header class="section__head reveal">
                    <h2 class="section__title">{{ 'app.refs.title'|trans }}</h2>
                    <p class="section__lead">{{ 'app.refs.lead'|trans }}</p>
                </header>

                <article class="case-feature">
                    <div class="case-feature__main">
                        <p class="case__cat">{{ 'app.references.mirwena_category'|trans }}</p>
                        <h3 class="case__title"><a href="{{ path('app_reference_mirwena') }}">{{ 'app.references.mirwena_title'|trans }}</a></h3>
                        <p class="case__text">{{ 'app.references.mirwena_text'|trans|raw }}</p>
                        <p class="case__tech">Symfony · PHP 8 · Doctrine · MariaDB · Docker · {{ 'app.references.mirwena_tech_privacy'|trans }}</p>
                        <p class="case__links">
                            <a href="{{ path('app_reference_mirwena') }}" class="arrow-link">{{ 'app.references.more'|trans }}</a>
                            <a href="https://mirwena.de" target="_blank" rel="noopener" class="case__ext">mirwena.de ↗</a>
                        </p>
                    </div>
                    <ul class="case-feature__list">
                        {% for n in 1..5 %}
                            <li>{{ ('app.references.mirwena_feature' ~ n)|trans|raw }}</li>
                        {% endfor %}
                    </ul>
                </article>

                <div class="case-grid">
                    {% for c in [
                        {key: 'freelancer', route: 'app_reference_freelancer', url: 'https://freelancer.achim-kraemer.com', host: 'freelancer.achim-kraemer.com', tech: 'Symfony 8 · PHP 8.5 · Doctrine · MariaDB · Docker'},
                        {key: 'signature', route: 'app_reference_email_signature', url: 'https://email-signatur.achim-kraemer.com', host: 'email-signatur.achim-kraemer.com', tech: 'Symfony · PHP 8 · Twig · JavaScript'},
                    ] %}
                        <article class="case">
                            <p class="case__cat">{{ ('app.references.' ~ c.key ~ '_category')|trans }}</p>
                            <h3 class="case__title"><a href="{{ path(c.route) }}">{{ ('app.references.' ~ c.key ~ '_title')|trans }}</a></h3>
                            <p class="case__text">{{ ('app.references.' ~ c.key ~ '_text')|trans }}</p>
                            <p class="case__tech">{{ c.tech }}</p>
                            <p class="case__links">
                                <a href="{{ path(c.route) }}" class="arrow-link">{{ 'app.references.more'|trans }}</a>
                                <a href="{{ c.url }}" target="_blank" rel="noopener" class="case__ext">{{ c.host }} ↗</a>
                            </p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ---------- Bereich 2: Websites & E-Mail ---------- #}
        <section id="websites" class="section section--web">
            <div class="wrap">
                <header class="section__head reveal">
                    <p class="kicker kicker--web">{{ 'app.web.kicker'|trans }}</p>
                    <h2 class="section__title">{{ 'app.web.title'|trans }}</h2>
                    <p class="section__lead">{{ 'app.web.lead'|trans }}</p>
                </header>

                <dl class="price-list">
                    {% for n in 1..6 %}
                        <div class="price-row">
                            <dt>
                                <span class="price-row__title">{{ ('app.web.p' ~ n ~ '_title')|trans }}</span>
                                <span class="price-row__text">{{ ('app.web.p' ~ n ~ '_text')|trans }}</span>
                            </dt>
                            <dd class="price-row__price">{{ ('app.web.p' ~ n ~ '_price')|trans }}</dd>
                        </div>
                    {% endfor %}
                </dl>
                <p class="price-note">{{ 'app.web.vat'|trans }}</p>

                <div class="web-foot">
                    <p class="web-foot__move">{{ 'app.web.move'|trans }}</p>
                    <p class="web-foot__links">
                        <a href="{{ path('app_service_packages') }}" class="arrow-link arrow-link--web">{{ 'app.web.link_packages'|trans }}</a>
                        <a href="{{ path('app_service_hosting') }}" class="arrow-link arrow-link--web">{{ 'app.web.link_hosting'|trans }}</a>
                    </p>
                </div>

                <h3 class="voices__title">{{ 'app.web.voices'|trans }}</h3>
                <div class="voices">
                    {% for t in [
                        {key: 'thomas', name: 'Thomas Stermann', site: 'therapie-stermann.de', photo: 'thomas.jpg'},
                        {key: 'iris', name: 'Iris Köster-Büscher', site: 'ibb-betreuungsbuero.de', photo: 'iris.jpg'},
                        {key: 'thorsten', name: 'Thorsten Meier', site: 'elb-solution.de', photo: 'thorsten.jpg'},
                    ] %}
                        <figure class="voice">
                            <blockquote lang="de" class="voice__quote">{{ ('app.testimonials.' ~ t.key ~ '_quote')|trans }}</blockquote>
                            <figcaption class="voice__who">
                                <img src="{{ asset('build/images/testimonials/' ~ t.photo) }}" alt="" loading="lazy" width="48" height="48">
                                <span>
                                    <strong>{{ t.name }}</strong>
                                    <span>{{ ('app.testimonials.' ~ t.key ~ '_role')|trans }} · <a href="https://{{ t.site }}" target="_blank" rel="noopener">{{ t.site }}</a></span>
                                </span>
                            </figcaption>
                        </figure>
                    {% endfor %}
                </div>

                <p class="section__cta"><a href="#contact" class="btn btn-web">{{ 'app.web.cta'|trans }}</a></p>
            </div>
        </section>

        {# ---------- Über mich ---------- #}
        <span id="portfolio" class="anchor-alias" aria-hidden="true"></span>
        <section id="about" class="section section--about">
            <div class="wrap about">
                <div class="about__text reveal">
                    <h2 class="section__title">{{ 'app.me.title'|trans }}</h2>
                    <p>{{ 'app.me.text1'|trans }}</p>
                    <p>{{ 'app.me.text2'|trans }}</p>
                </div>
                <div class="about__facts">
                    <ul>
                        <li>{{ 'app.me.fact1'|trans }}</li>
                        <li>{{ 'app.me.fact2'|trans }}</li>
                        <li>{{ 'app.me.fact3'|trans }}</li>
                    </ul>
                    <p class="about__find">{{ 'app.me.find'|trans }}</p>
                    <div class="about__social">
                        {{ include('_social_links.html.twig', {link_class: 'about__social-link', icon_class: 'w-5 h-5'}) }}
                    </div>
                </div>
            </div>
        </section>

        {# ---------- FAQ ---------- #}
        <section id="faq" class="section section--faq">
            <div class="wrap faq-wrap">
                <h2 class="section__title reveal">{{ 'app.faq.title'|trans }}</h2>
                <div class="faq-list">
                    {% for n in 1..10 %}
                        <details class="faq-item">
                            <summary class="faq-question">
                                <span>{{ ('app.faq.q' ~ n)|trans }}</span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="faq-chevron" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                            </summary>
                            <p class="faq-answer">{{ ('app.faq.a' ~ n)|trans }}</p>
                        </details>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ---------- Kontakt ---------- #}
        <section id="contact" class="section section--contact">
            <div class="wrap contact">
                <div class="contact__intro reveal">
                    <h2 class="section__title">{{ 'app.contact.title'|trans }}</h2>
                    <p class="section__lead">{{ 'app.contact.intro'|trans }}</p>
                    <ul class="contact__direct">
                        <li><a href="mailto:kontakt@achim-kraemer.com">kontakt@achim-kraemer.com</a></li>
                        <li><a href="tel:+491756821391">+49 1756 821391</a></li>
                        <li>Böckemeyerskamp 20, 49479 Ibbenbüren</li>
                    </ul>
                </div>
                <div id="contact-text" class="contact__form">
                    {% form_theme form 'form/recaptcha_lazy.html.twig' %}
                    {{ include('messages.html.twig') }}
                    {{ form_start(form, {'attr': {
                        'id': 'contact-form',
                        'data-recaptcha-key': form.captcha.vars.site_key,
                        'data-recaptcha-action': form.captcha.vars.action_name,
                        'data-sending-label': 'app.contact.sending'|trans,
                        'data-failed-label': 'app.contact.failed'|trans,
                    }}) }}
                        <div id="contact-form-status" class="contact-form-status" role="alert" hidden></div>
                        <div class="contact-form-grid">
                            {{ form_row(form.name) }}
                            {{ form_row(form.phone) }}
                            {{ form_row(form.email) }}
                            {{ form_row(form.message) }}
                            {{ form_row(form.captcha) }}
                        </div>
                        <input type="hidden" name="token" id="token">
                        <button type="submit" class="btn btn-ink contact-input-button">{{ 'app.contact.submit'|trans }}</button>
                        <p class="recaptcha-notice">{{ 'app.contact.recaptcha_notice'|trans|raw }}</p>
                    {{ form_end(form) }}
                </div>
            </div>
        </section>
    </main>

    <dialog id="contact-thanks" class="contact-thanks" aria-labelledby="contact-thanks-title">
        {# Kein Überschrift-Element: es ist bis zum Absenden leer und stünde sonst als leere Überschrift in der Gliederung #}
        <p id="contact-thanks-title" class="contact-thanks-title"></p>
        <p class="contact-thanks-text">{{ 'app.contact.thanks_text'|trans }}</p>
        <form method="dialog">
            <button type="submit" class="btn btn-ink w-full" autofocus>{{ 'app.contact.thanks_close'|trans }}</button>
        </form>
    </dialog>

    {{ include('_footer.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('home') }}
{% endblock %}
