{% set anchorBase = links is defined and links == 'direct' ? '' : path('app_home') %}
{% set items = {
    'entwicklung': 'app.nav.dev',
    'websites': 'app.nav.web',
    'references': 'app.nav.references',
    'about': 'app.nav.about',
} %}
{% set locale = app.request.locale %}

<nav id="nav-menu" class="main-nav" aria-label="{{ 'app.nav.menu'|trans }}">
    {% for anchor, label in items %}
        <a href="{{ anchorBase }}#{{ anchor }}" class="navigation-link" data-section="{{ anchor }}">{{ label|trans }}</a>
    {% endfor %}
    <a href="{{ anchorBase }}#contact" class="navigation-link main-nav__cta">{{ 'app.nav.contact'|trans }}</a>
</nav>

<div class="locale-switch">
    <a href="{{ path('switch_locale', {'locale': 'de'}) }}" lang="de" aria-current="{{ locale == 'de' ? 'true' : 'false' }}">DE</a>
    <a href="{{ path('switch_locale', {'locale': 'en'}) }}" lang="en" aria-current="{{ locale == 'en' ? 'true' : 'false' }}">EN</a>
</div>

<div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="{{ 'app.nav.menu'|trans }}">
        {% for anchor, label in items %}
            <a href="{{ anchorBase }}#{{ anchor }}" class="navigation-link">{{ label|trans }}</a>
        {% endfor %}
        <a href="{{ anchorBase }}#contact" class="navigation-link">{{ 'app.nav.contact'|trans }}</a>
    </nav>
    <div class="locale-switch">
        <a href="{{ path('switch_locale', {'locale': 'de'}) }}" lang="de" aria-current="{{ locale == 'de' ? 'true' : 'false' }}">Deutsch</a>
        <a href="{{ path('switch_locale', {'locale': 'en'}) }}" lang="en" aria-current="{{ locale == 'en' ? 'true' : 'false' }}">English</a>
    </div>
</div>
