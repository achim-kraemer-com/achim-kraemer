<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
    {% for url in urls %}
        {% for locale, loc in url.alternates %}
            <url>
                <loc>{{ loc }}</loc>
                {% for alternateLocale, alternateLoc in url.alternates %}
                    <xhtml:link rel="alternate" hreflang="{{ alternateLocale }}" href="{{ alternateLoc }}"/>
                {% endfor %}
                {% if url.alternates.de is defined %}
                    <xhtml:link rel="alternate" hreflang="x-default" href="{{ url.alternates.de }}"/>
                {% endif %}
                <priority>{{ url.priority }}</priority>
            </url>
        {% endfor %}
    {% endfor %}
</urlset>
