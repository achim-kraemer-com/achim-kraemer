{% extends 'base.html.twig' %}

{% set prefix = 'app.page.' ~ id ~ '.' %}

{% block title %}{{ (prefix ~ 'title')|trans }}{% endblock %}

{% block description %}{{ (prefix ~ 'description')|trans }}{% endblock %}

{% block structured_data %}
    {% set home_url = absolute_url(path('app_home')) %}
    {% set page_url = absolute_url(app.request.pathInfo) %}
    {% set main_entity = type == 'guide'
        ? {
            '@type': 'Article',
            'headline': (prefix ~ 'h1')|trans,
            'description': (prefix ~ 'description')|trans,
            'url': page_url,
            'inLanguage': app.request.locale,
            'datePublished': '2026-11-08',
            'image': absolute_url(asset('build/images/DSC4074.jpeg')),
            'author': {'@id': home_url ~ '#person'},
            'publisher': {'@id': home_url},
        }
        : type == 'service'
        ? {
            '@type': 'Service',
            'name': (prefix ~ 'h1')|trans,
            'description': (prefix ~ 'description')|trans,
            'url': page_url,
            'serviceType': (prefix ~ 'h1')|trans,
            'areaServed': 'DE',
            'provider': {'@id': home_url},
        }
        : {
            '@type': 'WebApplication',
            'name': (prefix ~ 'h1')|trans,
            'description': (prefix ~ 'description')|trans,
            'url': external_url,
            'applicationCategory': 'BusinessApplication',
            'operatingSystem': 'Web',
            'creator': {'@id': home_url ~ '#person'},
            'mainEntityOfPage': page_url,
        }
    %}
    {% set graph = {
        '@context': 'https://schema.org',
        '@graph': [
            main_entity,
            {
                '@type': 'BreadcrumbList',
                'itemListElement': [
                    {'@type': 'ListItem', 'position': 1, 'name': 'app.header.name'|trans, 'item': home_url},
                    {'@type': 'ListItem', 'position': 2, 'name': (prefix ~ 'h1')|trans, 'item': page_url},
                ],
            },
        ],
    } %}
    <script type="application/ld+json">{{ graph|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endblock %}

{% block body %}
    {# Wohin "Zurück" führt, wenn es keinen Verlauf gibt (z. B. direkt aus Google) #}
    {% set area = type == 'reference' ? 'references' : (id in ['hosting', 'packages'] ? 'websites' : 'entwicklung') %}
    {% set back = {
        href: path('app_home') ~ '#' ~ area,
        label: (area == 'references' ? 'app.back.to_references' : (area == 'websites' ? 'app.back.to_web' : 'app.back.to_dev'))|trans,
    } %}
    {% set area_label = (area == 'references' ? 'app.nav.references' : (area == 'websites' ? 'app.nav.web' : 'app.nav.dev'))|trans %}
    {% set tone = area == 'websites' ? 'web' : 'dev' %}

    {% include '_scroll_navigation.html.twig' with {'links': '', 'back': back} %}

    <main class="detail detail--{{ tone }}">
        <div class="wrap detail__wrap">
            <nav aria-label="Breadcrumb" class="detail__crumbs">
                <a href="{{ path('app_home') }}">{{ 'app.header.name'|trans }}</a>
                <span aria-hidden="true">/</span>
                <a href="{{ back.href }}" data-back>{{ area_label }}</a>
            </nav>

            <article>
                <p class="kicker kicker--{{ tone }}">{{ ('app.page.eyebrow_' ~ type)|trans }}</p>
                <h1 class="detail__title">{{ (prefix ~ 'h1')|trans }}</h1>
                <p class="detail__lead">{{ (prefix ~ 'lead')|trans }}</p>

                <ul class="detail__points">
                    {% for n in 1..4 %}
                        <li><span>{{ (prefix ~ 'b' ~ n)|trans|raw }}</span></li>
                    {% endfor %}
                </ul>

                {# Preisseiten zeigen den Inhalt vor den Fragen #}
                {% if content_first|default(false) %}
                    {% include 'page/content/' ~ id ~ '.' ~ app.request.locale ~ '.html.twig' ignore missing %}
                {% endif %}

                <div class="detail__qa">
                    {% for n in 1..3 %}
                        <section>
                            <h2>{{ (prefix ~ 'q' ~ n)|trans }}</h2>
                            <p>{{ (prefix ~ 'a' ~ n)|trans }}</p>
                        </section>
                    {% endfor %}
                </div>

                {# Ausführlicher Teil für längere Seiten, je Sprache eine eigene Datei #}
                {% if not content_first|default(false) %}
                    {% include 'page/content/' ~ id ~ '.' ~ app.request.locale ~ '.html.twig' ignore missing %}
                {% endif %}

                <p class="detail__tech">{{ tech|join(' · ') }}</p>

                <div class="detail__end">
                    <div>
                        <p class="detail__end-title">{{ 'app.contact.title'|trans }}</p>
                        <p class="detail__end-text">kontakt@achim-kraemer.com · +49 1756 821391</p>
                    </div>
                    <div class="detail__end-actions">
                        <a href="{{ path('app_home') }}#contact" class="btn btn-{{ tone }}">{{ 'app.page.cta'|trans }}</a>
                        {% if external_url %}
                            <a href="{{ external_url }}" target="_blank" rel="noopener" class="btn btn-line">{{ (prefix ~ 'link')|trans }} ↗</a>
                        {% endif %}
                    </div>
                </div>

                <p class="detail__back">
                    <a href="{{ back.href }}" class="back-link" data-back>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
                        <span>{{ back.label }}</span>
                    </a>
                </p>
            </article>
        </div>
    </main>

    {{ include('_footer.html.twig') }}
{% endblock %}
