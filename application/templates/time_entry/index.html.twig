{% extends 'base.html.twig' %}

{% block title %}{{ 'app.time_entry.title'|trans }}{% endblock %}

{% block body %}
<div class="container">
    <div class="table-container bg-gray-800 p-8 overflow-x-auto">
        <h1>{{ 'app.time_entry.title'|trans }}</h1>

        <table class="table min-w-full">
            <thead>
                <tr>
                    <th>{{ 'app.time_entry.date'|trans }}</th>
                    <th>{{ 'app.time_entry.project'|trans }}</th>
                    <th>{{ 'app.time_entry.hours'|trans }}</th>
                    <th>{{ 'app.time_entry.price'|trans }}</th>
                    <th>{{ 'app.time_entry.description'|trans }}</th>
                    <th>{{ 'app.time_entry.invoiced'|trans }}</th>
                    <th>{{ 'app.time_entry.timer'|trans }}</th>
                    <th>{{ 'app.time_entry.timer_actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for time_entry in time_entries %}
                <tr>
                    <td><a href="{{ path('admin_time_entry_edit', {'id': time_entry.id}) }}">{{ time_entry.date ? time_entry.date|date('d.m.Y') : '' }}</a></td>
                    <td>{{ time_entry.project }}</td>
                    <td>{% if time_entry.hours != null %}{{ time_entry.hours|decimal_to_time }} Std.{% endif %}</td>
                    <td>{{ time_entry.price|replace({'.': ','}) }} {% if time_entry.price != null %}€{% endif %}</td>
                    <td>{{ time_entry.description }}</td>
                    <td>{{ time_entry.invoiced ? 'app.default.yes'|trans : 'app.default.no'|trans }}</td>
                    <td>
                        <span class="timer-display font-mono{{ time_entry.timerRunning ? ' timer-running' : '' }}"
                              data-timer
                              data-seconds="{{ time_entry.elapsedSeconds }}"
                              data-running="{{ time_entry.timerRunning ? '1' : '0' }}"></span>
                    </td>
                    <td>
                        <div class="timer-actions flex gap-2">
                            {% if time_entry.timerRunning %}
                                <form method="post" action="{{ path('admin_time_entry_timer_stop', {'id': time_entry.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('timer' ~ time_entry.id) }}">
                                    <button class="button btn">{{ 'app.time_entry.timer_stop'|trans }}</button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('admin_time_entry_timer_start', {'id': time_entry.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('timer' ~ time_entry.id) }}">
                                    <button class="button btn">{{ 'app.time_entry.timer_start'|trans }}</button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('admin_time_entry_timer_finish', {'id': time_entry.id}) }}"
                                  onsubmit="return confirm('{{ 'app.time_entry.timer_finish_confirm'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('timer' ~ time_entry.id) }}">
                                <button class="button btn">{{ 'app.time_entry.timer_finish'|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a class="button mt-4" href="{{ path('admin_time_entry_new') }}">{{ 'app.time_entry.new_time_entry'|trans }}</a>
        <a class="button mt-4" href="{{ path('admin_index') }}">{{ 'app.default.back_to_list'|trans }}</a>
    </div>
</div>
{% endblock %}
